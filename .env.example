DATABASE_URL=postgresql://efm_app:replace-with-app-password@localhost:5432/efm
REDIS_URL=redis://:replace-with-redis-password@localhost:6379/0
LLM_BASE_URL=
LLM_MODEL=fast
LLM_API_KEY=replace-with-api-key
ENV=dev
CHILD_TOKENS=600
CHILD_OVERLAP=75
PARENT_TOKENS=1200
K_EACH=20
K_FUSED=20
K_FINAL=5
RRF_K=60
GRADE_LOW=0.35
GRADE_HIGH=0.75
CACHE_SIM=0.96
CACHE_TTL_SECONDS=3600
MAX_REWRITES=1
MAX_REGENERATIONS=1
HEALTH_CHECK_TIMEOUT=3
RERANKER_MAX_PASSAGE_TOKENS=384
RERANKER_BATCH_SIZE=16
POSTGRES_DB=efm
POSTGRES_USER=efm_admin
POSTGRES_PASSWORD=replace-with-postgres-password
EFM_APP_PASSWORD=replace-with-app-password
REDIS_PASSWORD=replace-with-redis-password
